# Copie para /etc/interpretaai/keycloak.env com root:root 0600.
# Gere cada segredo fora do Git, por exemplo: openssl rand -hex 32
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://10.220.10.10:5432/interpretaai_keycloak
KC_DB_USERNAME=interpretaai_keycloak
KC_DB_PASSWORD=

KC_HOSTNAME=https://interpretaai.deskimperial.online/auth
KC_HTTP_ENABLED=true
KC_HTTP_RELATIVE_PATH=/auth
KC_PROXY_HEADERS=xforwarded
KC_PROXY_TRUSTED_ADDRESSES=172.16.0.0/12
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
KC_CACHE=local
KC_BOOTSTRAP_ADMIN_USERNAME=interpretaai-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
JAVA_OPTS_KC_HEAP=-XX:InitialRAMPercentage=25 -XX:MaxRAMPercentage=65
