# Copie para /etc/interpretaai/server.env e restrinja com chmod 640.
# Não coloque o arquivo real no Git.
SERVER_ADDRESS=127.0.0.1
PORT=8088

DATABASE_URL=jdbc:h2:file:/var/lib/interpretaai/data/interpretaai;MODE=PostgreSQL;AUTO_SERVER=TRUE
DATABASE_USERNAME=sa
DATABASE_PASSWORD=
IDEMPOTENCY_FINGERPRINT_SECRET=troque-por-um-segredo-aleatorio-com-32-caracteres

# A API docente v2 exige OIDC e vínculos institucionais no banco. O Caddyfile
# padrão não a expõe. Só use Caddyfile.v2.example após validar o provedor.
OIDC_ENABLED=false
OIDC_ISSUER_URI=
OIDC_AUDIENCE=interpretaai-api
AUTHORING_WORKER_ENABLED=false
AUTHORING_PLAN_WORKER_ENABLED=false
AUTHORING_MODEL=

SCENE_PACK_VERSION=v2
CONVERSATION_PROVIDER=ollama
CONVERSATION_ROUTE=ollama
CONVERSATION_DEADLINE_MS=4000
CONVERSATION_PROVIDER_TIMEOUT_MS=3500
CONVERSATION_MAX_CONCURRENT=2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_WARMUP_ENABLED=true

# Ative somente depois de gerar três tokens aleatórios diferentes com pelo menos 16 caracteres.
PILOT_SYNC_ENABLED=false
PILOT_SYNC_TEACHER_TOKEN=
PILOT_SYNC_DEVICE_TOKEN=
PILOT_SYNC_SECRETARY_TOKEN=
# Ative junto com PILOT_SYNC_ENABLED para exigir o token do tablet também na conversa.
VOICE_AUTH_ENABLED=true
VOICE_RATE_LIMIT_ENABLED=true
VOICE_RATE_LIMIT_MAX_REQUESTS=8
VOICE_RATE_LIMIT_WINDOW_SECONDS=60

SPEECH_PROVIDER=kokoro
KOKORO_BASE_URL=http://127.0.0.1:8091

# Somente benchmark sintético, nunca fluxo infantil sob os termos atuais.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=LOW
GEMINI_WARMUP_ENABLED=false
NVIDIA_API_KEY=
NVIDIA_MODEL=mistralai/mistral-nemotron
NVIDIA_WARMUP_ENABLED=false
