# Modelo sem segredos. Instale como /etc/interpretaai/v2-staging.env (root:interpretaai, 0640).
SERVER_ADDRESS=127.0.0.1
PORT=8188
SERVER_FORWARD_HEADERS_STRATEGY=framework
INTERPRETAAI_RELEASE_REVISION=replace-with-full-git-commit

# Obrigatório: banco exclusivo restaurável. Nunca aponte o staging para o banco ativo.
DATABASE_URL=jdbc:postgresql://10.220.10.10:6432/interpretaai_v2_staging
DATABASE_USERNAME=
DATABASE_PASSWORD=
IDEMPOTENCY_FINGERPRINT_SECRET=

OIDC_ENABLED=true
OIDC_ISSUER_URI=
OIDC_AUDIENCE=interpretaai-api
STUDIO_ENABLED=true
STUDIO_COOKIE_SECURE=true
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_STUDIO_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_STUDIO_CLIENT_SECRET=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_STUDIO_SCOPE=openid,profile
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_STUDIO_ISSUER_URI=

# Abrir um recurso por vez após autenticação e armazenamento serem provados.
DEVICE_PAIRING_ENABLED=false
DEVICE_PAIRING_SECRET=
MEDIA_STORAGE=local
MEDIA_LOCAL_ROOT=/var/lib/interpretaai-v2-staging/private-media
MEDIA_WORKER_ENABLED=false
AUTHORING_WORKER_ENABLED=false
AUTHORING_PLAN_WORKER_ENABLED=false
AUTHORING_MODEL=

# A conversa v1 pode compartilhar os provedores privados; não habilita geração docente.
CONVERSATION_PROVIDER=ollama
CONVERSATION_ROUTE=ollama
OLLAMA_BASE_URL=http://10.220.10.10:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_WARMUP_ENABLED=false
SPEECH_PROVIDER=kokoro
KOKORO_BASE_URL=http://127.0.0.1:8080
GEMINI_WARMUP_ENABLED=false
NVIDIA_WARMUP_ENABLED=false
PILOT_SYNC_ENABLED=false
VOICE_AUTH_ENABLED=true
VOICE_RATE_LIMIT_ENABLED=true
